<?xml version="1.0" encoding="utf-8"?>
<!-- Barra translúcida tipo buscador: el fondo de pantalla se ve a través; borde y micrófono con el color del tema -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <FrameLayout
        android:id="@+id/w_voz"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/w_voz">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_fondo"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/w_borde"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar_borde"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="9dp"
            android:paddingRight="6dp">

            <ImageView
                android:id="@+id/w_abrir"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_dona_circulo"
                android:contentDescription="@string/w_abrir" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/w_hint"
                android:textColor="#F1E8D6"
                android:textSize="15sp"
                android:shadowColor="#66000000"
                android:shadowRadius="2" />

            <ImageView
                android:id="@+id/w_mic"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_mic"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
